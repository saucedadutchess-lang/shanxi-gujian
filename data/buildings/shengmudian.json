  "stories": [
    {
      "title": "一片桐叶封出来的晋国",
      "paras": [
        {
          "text": "周成王和弟弟叔虞玩，把桐叶削成玉圭的样子给他，说：“以此封若。”史官请择日立叔虞，成王说只是玩笑。史官答：天子无戏言。叔虞于是封在唐。",
          "kind": "史料记载",
          "src": [
            "shiji-39"
          ],
          "where": "唐叔虞部分"
        },
        {
          "text": "叔虞的儿子燮改称晋侯。方志说因晋水改国号为晋，晋祠最早就是祭叔虞的祠。",
          "kind": "史料记载",
          "src": [
            "shiji-39",
            "sxtz-164"
          ],
          "where": "《史记》唐叔虞部分；《山西通志》太原县“唐叔虞祠”条"
        }
      ]
    },
    {
      "title": "主角换成了圣母",
      "paras": [
        {
          "text": "北魏时水边只说有唐叔虞祠。到了宋代，水源之西建起女郎祠，熙宁时封为“显灵昭济圣母”。同一本方志里，唐叔虞祠另立一条，两处祭的不是一位神。",
          "kind": "史料记载",
          "src": [
            "shuijing-6",
            "sxtz-164"
          ],
          "where": "《水经注》晋水部分；《山西通志》太原县“唐叔虞祠”“晋源神祠”条"
        },
        {
          "text": "今天一般说殿里供的是邑姜，周武王的妻子、叔虞的母亲。我读到的《山西通志》这两条没有写圣母就是邑姜。",
          "kind": "学界推断",
          "src": [
            "gmw-jinci-2024",
            "sxtz-164"
          ],
          "where": "《光明日报》正文；《山西通志》同上两条"
        }
      ]
    },
    {
      "title": "车窗外的一瞥",
      "paras": [
        {
          "text": "林徽因和梁思成坐汽车从祠后经过时望见了正殿，后来又专门回来看。他们看到前廊“异常空敞”，又把殿前的飞梁称作当时所知的唯一孤例。",
          "kind": "史料记载",
          "src": [
            "lin-liang-1935"
          ],
          "where": "“太原县 晋祠”"
        }
      ]
    }
  ],
  "keys": {
    "form": {
      "text": "重檐歇山顶：上檐是一座歇山，下檐是殿身四周一圈围廊的屋顶。",
      "facts": [
        {
          "text": "面阔七间、进深六间，平面近方形。真正的殿身是五间，外面一圈廊子叫“副阶周匝”，所以从外面数是七间。",
          "kind": "史料记载",
          "src": [
            "lin-liang-1935"
          ],
          "where": "“太原县 晋祠”"
        },
        {
          "text": "正面从平柱到角柱逐渐升高，“有显著的生起”。",
          "kind": "史料记载",
          "src": [
            "lin-liang-1935"
          ],
          "where": "“太原县 晋祠”"
        }
      ]
    },
    "grade": {
