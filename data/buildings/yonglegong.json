  "stories": [
    {
      "title": "一座宫两班画工",
      "paras": [
        {
          "text": "三清殿东半部和云气的题记，署的是马君祥为首的画工班子，自称来自河南府洛京。",
          "kind": "史料记载",
          "src": [
            "thepaper-yonglegong-2024"
          ],
          "where": "三清殿画工一节"
        },
        {
          "text": "文章作者认为，西半部更可能出自朱好古一派的画工；三十多年后纯阳殿的壁画，就是朱好古的门人张遵礼等人画的。",
          "kind": "学界推断",
          "src": [
            "thepaper-yonglegong-2024"
          ],
          "where": "三清殿画工一节、纯阳殿题记一节"
        }
      ]
    },
    {
      "title": "整座宫搬家",
      "paras": [
        {
          "text": "文物工作者和几百名民工几乎全靠手工，把整座宫连同壁画迁到二十多公里外。",
          "kind": "史料记载",
          "src": [
            "chinanews-yonglegong-2013"
          ],
          "where": "开头"
        },
        {
          "text": "迁建时以祁英涛为代表的专家主张“存真”：换下来的原构件不再装回，装上去的是仿制品，原件另外保存，所以今天还能拿出来展览和研究。",
          "kind": "史料记载",
          "src": [
            "scol-yonglegong-2026"
          ],
          "where": "“存真”一段"
        }
      ]
    },
    {
      "title": "鸱吻里的经卷",
      "paras": [
        {
          "text": "1959 年拆重阳殿时，在屋脊鸱吻里发现一卷宋金时期的道经《无量度人上品妙经》，现为国家一级文物。",
          "kind": "史料记载",
          "src": [
            "scol-yonglegong-2026"
          ],
          "where": "重阳殿鸱吻一段"
        }
      ]
    }
