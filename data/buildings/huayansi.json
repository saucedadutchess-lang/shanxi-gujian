  "stories": [
    {
      "title": "供着皇帝的寺",
      "paras": [
        {
          "text": "《辽史》说，寺建起来以后，安放了辽朝诸帝的石像和铜像。它不只是座佛寺。",
          "kind": "史料记载",
          "src": [
            "liaoshi-41"
          ],
          "where": "西京道，大同府"
        },
        {
          "text": "辽亡以后过了四十来年，金世宗来看这些铜像，叫住持好好看着。前朝皇帝的像，后朝还留着。",
          "kind": "史料记载",
          "src": [
            "jinshi-6"
          ],
          "where": "大定六年五月戊申"
        }
      ]
    },
    {
      "title": "为什么朝东",
      "paras": [
        {
          "text": "中国佛寺多数朝南，华严寺朝东。常见的解释是契丹人敬太阳，以东为尊。",
          "kind": "学界推断",
          "src": [
            "hankun-2026",
            "sxwl-huayansi-2022"
          ],
          "where": "两文讲朝向的一段",
          "check": "两篇都是普及文章，没有注明依据哪项研究。"
        }
      ]
    },
    {
      "title": "同一批木匠",
      "paras": [
        {
          "text": "薄伽教藏殿的斗拱和殿里书柜上的小斗拱，尺寸不同，规矩却是一套。研究者推想，盖殿和做书柜的是同门，甚至同一批木匠。",
          "kind": "学界推断",
          "src": [
            "zhao-li-li-2023"
          ],
          "where": "第 168–170 页"
        },
        {
          "text": "书柜里中间那座楼阁最高，屋脊会碰到大殿的斗拱，木匠就把两者前后错开了。",
          "kind": "学界推断",
          "src": [
            "zhao-li-li-2023"
          ],
          "where": "第 167 页"
        }
      ]
    },
    {
      "title": "露齿的菩萨",
      "paras": [
        {
          "text": "薄伽教藏殿有一尊双手合十、微微露出牙齿的菩萨。流行的说法是，郑振铎叫她“东方维纳斯”。郑振铎的原文没有核到。",
          "kind": "民间传说",
          "src": [
            "sxwl-huayansi-2022"
          ],
          "where": "辽代造像一段"
        }
      ]
    }
  ],
  "keys": {
    "form": {
      "text": "一座寺里能比两种顶：大雄宝殿是单檐庑殿，薄伽教藏殿是单檐歇山。",
      "facts": [
        {
          "text": "大雄宝殿面阔九间、进深五间，53.7 × 27.5 米。",
          "kind": "史料记载",
          "src": [
            "zhou-qian-2023"
          ],
          "where": "引言"
        },
        {
          "text": "薄伽教藏殿面阔五间、进深四间。按柱头算，研究者复原为 85 尺 × 61 尺，一尺约 300 毫米，合 25.5 × 18.3 米。",
          "kind": "学界推断",
          "src": [
            "zhao-li-li-2023"
          ],
          "where": "第 162 页"
        }
      ]
    },
    "grade": {
      "text": "殿大，斗拱不一定出跳多。大雄宝殿比佛光寺东大殿宽两间，斗拱却少出两跳。",
      "rule": {
        "text": "斗拱从柱头大斗往外，每伸出一层栱或昂叫一跳。出两跳是五铺作，出三跳是六铺作，出四跳是七铺作。",
        "kind": "史料记载",
        "src": [
          "yzfs"
        ],
        "where": "卷四 大木作制度一 · 总铺作次序"
      },
      "with": "佛光寺东大殿",
