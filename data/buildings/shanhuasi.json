  "stories": [
    {
      "title": "被扣在寺里的南宋使臣",
      "paras": [
        {
          "text": "朱弁作为南宋的通问副使出使金国，被扣在西京大同，住在大普恩寺里。他和住持圆满结下交情，亲眼看着寺院一点点修起来，后来应邀写了这篇碑记。",
          "kind": "史料记载",
          "src": [
            "li-zhenming-2010"
          ],
          "where": "“朱弁在大普恩寺期间”一段"
        },
        {
          "text": "碑文写辽末的战火：“楼阁飞为埃坋，殿堂聚为瓦砾”。",
          "kind": "史料记载",
          "src": [
            "li-zhenming-2010"
          ],
          "where": "引碑文"
        }
      ]
    },
    {
      "title": "“重修”还是“重建”",
      "paras": [
        {
          "text": "碑题写的是“重修大殿”，不是“重建”。李振明据此和大殿的辽式结构认为，大雄宝殿就是辽末劫后幸存的那十之三四。",
          "kind": "学界推断",
          "src": [
            "li-zhenming-2010"
          ],
          "where": "论“凡为大殿”一段"
        }
      ]
    },
    {
      "title": "一寺三名",
      "paras": [
        {
          "text": "开元寺、大普恩寺、善化寺，三个名字对应唐、辽、明三个朝代。",
          "kind": "史料记载",
          "src": [
            "bjqnb-shanhuasi-2026"
          ],
          "where": "标题及开头"
        }
      ]
    },
    {
      "title": "从印度来的吉祥天",
      "paras": [
        {
          "text": "大殿两侧的二十四诸天里，有一尊大吉祥功德天，研究者认为她的源头是印度教的吉祥天女拉克什米。",
          "kind": "学界推断",
          "src": [
            "bjqnb-shanhuasi-2026"
          ],
          "where": "“诸神汇聚处”一段"
        }
      ]
    }
  ],
