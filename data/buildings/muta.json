  "stories": [
    {
      "title": "寄给“应县最高等照相馆”的信",
      "paras": [
        {
          "text": "梁思成想先看看木塔还在不在，长什么样，就写了一封信，收信人是“应县最高等照相馆”。县里其实只有一家照相馆，店主主业修钟表。",
          "kind": "史料记载",
          "src": [
            "shanhe-2022"
          ],
          "where": "照相馆一段"
        },
        {
          "text": "店主拍了木塔寄来，不要钱，只要北平的信纸和信笺。店主的名字，有写高老五的，也有写高培华的。",
          "kind": "史料记载",
          "src": [
            "shanhe-2022"
          ],
          "where": "照相馆一段和图注"
        },
        {
          "text": "1933 年，梁思成、刘敦桢、莫宗江、纪玉堂四人从大同经岱岳镇，换骡车到了应县。",
          "kind": "史料记载",
          "src": [
            "shanhe-2022"
          ],
          "where": "到达一段"
        }
      ]
    },
    {
      "title": "佛像肚子里的辽代书库",
      "paras": [
        {
          "text": "1974 年修塔，从四层、二层的主像里取出一批文物：辽藏十二单卷、刻经、写经、杂刻杂抄，还有七珍和佛牙舍利。",
          "kind": "史料记载",
          "src": [
            "zhao-ping-2022"
          ],
          "where": "1974 年一段"
        },
        {
          "text": "书里说，辽藏这十二单卷填补了辽版大藏经的空白。",
          "kind": "史料记载",
          "src": [
            "zhao-ping-2022"
          ],
          "where": "1974 年一段"
        }
      ]
    },
    {
      "title": "玲珑宝塔不玲珑",
      "paras": [
        {
          "text": "木塔原来只在东西南北四面开门，其余是夹泥墙，墙里藏着斜撑。1930 年代，当地主张修塔的人嫌“玲珑宝塔不玲珑”，坏了风水，把墙和斜撑拆了，换成格子门。",
          "kind": "史料记载",
          "src": [
            "wang-nan-2020b",
            "xhmrdx-2020",
            "shanhe-2022"
          ],
          "where": "讲塔门的一段；报道和山河小岁月文拆墙一段"
        },
        {
          "text": "1950 年前后莫宗江再来，看到塔身已经歪向东北。",
          "kind": "史料记载",
          "src": [
            "xhmrdx-2020"
          ],
          "where": "报道引莫宗江报告"
        }
      ]
    },
    {
      "title": "皇后的家乡",
      "paras": [
        {
          "text": "地方上说，辽兴宗的皇后萧挞里是应县人，木塔是为她家乡建的。",
          "kind": "民间传说",
          "src": [
            "zhao-ping-2022"
          ],
          "where": "萧挞里一段"
        },
        {
          "text": "又说洪武元年四月初八，塔顶的佛灯一连亮了三夜。",
          "kind": "民间传说",
          "src": [
            "zhao-ping-2022"
          ],
          "where": "佛灯一段"
        }
      ]
    }
  ],
  "keys": {
    "form": {
      "text": "八角形的楼阁式塔，最上面是八角攒尖顶。屋檐六层，楼有五层，里面还藏着四层。",
      "facts": [
        {
          "text": "数屋檐是六层：最下面一层是围廊（副阶）的檐，往上每个明层一层。",
          "kind": "史料记载",
          "src": [
            "li-zehui-2021"
          ],
          "where": "面阔折线图里副阶、一至五层分列"
        },
        {
          "text": "数楼层是五层，每两层之间夹一个暗层，共四个，所以实际是九层。",
          "kind": "史料记载",
          "src": [
            "sxwwj-muta",
            "chen-mingda"
          ],
          "where": "介绍正文"
        },
        {
          "text": "越往上越小。每面柱头宽，一层 9.55 米，五层 8.00 米。每上一层，外墙往里收约 0.3–0.5 米。",
          "kind": "史料记载",
          "src": [
            "li-zehui-2021"
          ],
          "where": "面阔折线图（1991 年前后测绘）；退进差值表"
        },
        {
          "text": "屋檐不是每层一样大。从剖面小图上量，上面三层的出檐比二层短。",
          "kind": "学界推断",
          "src": [
            "li-zehui-2021"
          ],
          "where": "剖面变形图（按小图量，误差约 0.3 米）"
        }
      ]
    },
    "grade": {
      "text": "看斗拱：越往上，出跳越少。和佛光寺东大殿比，最高的一档一样是七铺作。",
      "rule": {
        "text": "斗拱从柱头大斗往外，每伸出一层栱或昂叫一跳。出两跳是五铺作，出三跳是六铺作，出四跳是七铺作。",
        "kind": "史料记载",
        "src": [
          "yzfs"
        ],
        "where": "卷四 大木作制度一 · 总铺作次序"
      },
      "with": "佛光寺东大殿",
